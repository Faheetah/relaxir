<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Receipt</h1>
    <p class="text-gray-600">
      Scan receipts to extract purchased items and add them to your inventory.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Left column: Upload and instructions -->
    <div class="bg-white rounded-lg shadow p-6 min-h-0 overflow-auto">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Scan Receipt</h2>

      <div :if={is_nil(@image_filename)} class="mb-6">
        <div class="text-center py-8">
          <.icon name="hero-document" class="w-24 h-24 text-gray-300 mx-auto mb-6" />
          <p class="text-gray-700 mb-4">
            Upload a receipt image to scan purchased items automatically.
          </p>

          <.link
            navigate={~p"/receipts/upload?path=&redirect=/receipt&preserve_size=true"}
            class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
          >
            <.icon name="hero-cloud-arrow-up" class="w-5 h-5 mr-2" />
            Upload Receipt
          </.link>

          <p class="text-sm text-gray-500 mt-4">
            Supported formats: JPG, JPEG, PNG, AVIF
          </p>
        </div>
      </div>

      <div :if={@image_filename} class="mb-6">
        <div class="text-center">
          <!-- Display the receipt image -->
          <div class="mb-6">
            <img
              src={@image_url}
              alt="Uploaded receipt"
              class="w-full h-auto rounded-lg shadow-lg border border-gray-200"
            />
          </div>

          <!-- Reupload button -->
          <.link
            navigate={~p"/receipts/upload?path=&redirect=/receipt&preserve_size=true"}
            class="inline-flex items-center px-6 py-3 bg-gray-600 text-white font-medium rounded-lg hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2"
          >
            <.icon name="hero-cloud-arrow-up" class="w-5 h-5 mr-2" />
            Reupload Receipt
          </.link>

          <p class="text-sm text-gray-500 mt-4">
            Upload a different receipt image
          </p>
        </div>
      </div>


      <div :if={@scan_error} class="mb-6">
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <div class="flex items-center">
            <.icon name="hero-exclamation-triangle" class="w-5 h-5 text-red-500 mr-2" />
            <p class="text-red-700"><%= @scan_error %></p>
          </div>
        </div>
      </div>

      <div class="flex justify-end">
        <button
          type="button"
          phx-click="clear-all"
          class="px-4 py-2 text-sm text-gray-600 hover:text-gray-800 disabled:opacity-50 disabled:cursor-not-allowed"
          disabled={length(@scanned_items) == 0}
        >
          Clear All Items
        </button>
      </div>

      <!-- Edit Item Modal -->
      <div :if={@edit_modal_open} class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
          <!-- Background overlay -->
          <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>

          <!-- Modal panel -->
          <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
              <div class="sm:flex sm:items-start">
                <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
                  <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="modal-title">
                    Edit Item: <%= @editing_item && String.capitalize(@editing_item.name) %>
                  </h3>

                  <div class="mt-4">
                    <p class="text-sm text-gray-600 mb-4">
                      Search for an existing ingredient to match this item:
                    </p>

                    <.live_select
                      id="item-name-edit-modal"
                      field={to_form(%{"item_name_edit" => @editing_item && (@editing_item.closest_match || @editing_item.name)})[:item_name_edit]}
                      mode={:single}
                      allow_clear={false}
                      dropdown_extra_class="mt-2"
                      option_extra_class="py-2"
                      container_extra_class="flex flex-col"
                      text_input_extra_class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                      placeholder="Search ingredient..."
                      style={:tailwind}
                    />

                    <div :if={length(@editing_item_search_results) > 0} class="mt-4">
                      <p class="text-sm text-gray-600 mb-2">Top matches:</p>
                      <div class="space-y-2 max-h-60 overflow-y-auto">
                        <button
                          type="button"
                          :for={ingredient <- @editing_item_search_results}
                          phx-click="select-ingredient"
                          phx-value-ingredient-id={ingredient.id}
                          class="w-full text-left p-3 bg-gray-50 hover:bg-gray-100 rounded-lg border border-gray-200 flex items-center justify-between"
                        >
                          <div>
                            <div class="font-medium text-gray-900"><%= ingredient.name %></div>
                            <div class="text-sm text-gray-600">
                              <%= ingredient.description || "No description" %>
                            </div>
                          </div>
                          <div class="text-blue-600 font-medium text-sm">Select</div>
                        </button>
                      </div>
                    </div>

                    <div :if={length(@editing_item_search_results) == 0} class="mt-4">
                      <p class="text-sm text-gray-500 italic">No matches found. Try a different search term.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
              <button
                type="button"
                phx-click="close-edit-modal"
                class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 sm:mt-0 sm:w-auto sm:text-sm"
              >
                Cancel
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: Scanned items -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold text-gray-800">Scanned Items</h2>
        <span class="px-3 py-1 bg-blue-100 text-blue-800 text-sm font-medium rounded-full">
          <%= length(@scanned_items) %> items
        </span>
      </div>

      <div :if={@scanning} class="flex items-center justify-center h-full min-h-[300px]">
        <div id={"scanning-status-#{@scan_started_at}"} class="p-8">
          <div class="flex flex-col items-center justify-center">
            <div class="animate-spin mb-4">
              <.icon name="hero-arrow-path" class="w-12 h-12 text-gray-700" />
            </div>
            <div>
              <p class="text-gray-800 text-xl font-light">Loading receipt...</p>
            </div>
          </div>
        </div>
      </div>

      <div :if={length(@scanned_items) == 0 and !@scanning} class="text-center py-12">
        <.icon name="hero-shopping-bag" class="w-16 h-16 text-gray-300 mx-auto mb-4" />
        <p class="text-gray-500 mb-2">No scanned items yet</p>
        <p class="text-sm text-gray-400">
          Upload a receipt image to scan purchased items
        </p>
      </div>

      <div :if={length(@scanned_items) > 0} class="space-y-4">
        <div
          :for={{item, index} <- Enum.with_index(@scanned_items)}
          class="border border-gray-200 rounded-lg p-4 hover:bg-gray-50"
        >
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="flex-1">
              <div class="flex items-center mb-2">
                <div class="flex items-center">
                  <button
                    type="button"
                    phx-click="start-edit-item"
                    phx-value-item-index={index}
                    class="text-left hover:text-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 rounded"
                  >
                    <h3 class="font-medium text-gray-900 text-lg hover:text-blue-600">
                      <%= String.capitalize(item.name) %>
                    </h3>
                  </button>
                  <span
                    :if={item.is_new}
                    class="ml-2 px-2 py-1 bg-yellow-100 text-yellow-800 text-xs font-medium rounded"
                  >
                    New
                  </span>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row sm:items-center text-sm text-gray-600 mb-2 gap-2">
                <div class="flex items-center">
                  <.icon name="hero-cube" class="w-4 h-4 mr-1 flex-shrink-0" />
                  <span class="truncate">
                    <%= if item.amount do %>
                      <%= item.amount %> count
                    <% else %>
                      1 count
                    <% end %>
                  </span>
                </div>
                <div class="flex items-center">
                  <.icon name="hero-document-text" class="w-4 h-4 mr-1 flex-shrink-0" />
                  <span class="truncate max-w-xs" title={item.original_text}>
                    <%= item.original_text || "No original text" %>
                  </span>
                </div>
              </div>

            </div>

            <div class="flex items-center justify-end md:justify-start space-x-2">
              <button
                :if={item.is_new}
                type="button"
                phx-click="start-edit-item"
                phx-value-item-index={index}
                class="px-3 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-300 focus:ring-offset-2 flex items-center"
              >
                <.icon name="hero-pencil" class="w-4 h-4 mr-1 md:mr-2" />
                <span class="hidden sm:inline">Edit</span>
                <span class="sm:hidden">Edit</span>
              </button>
              <button
                type="button"
                phx-click="add-to-inventory"
                phx-value-item-index={index}
                class="px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 flex items-center"
              >
                <.icon name="hero-plus" class="w-4 h-4 mr-1 md:mr-2" />
                <span class="hidden sm:inline">Add</span>
                <span class="sm:hidden">Add</span>
              </button>
              <button
                type="button"
                phx-click="skip-item"
                phx-value-item-index={index}
                class="px-3 py-2 bg-red-50 text-red-700 text-sm font-medium rounded-lg hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-300 focus:ring-offset-2 flex items-center border border-red-200"
              >
                <.icon name="hero-x-mark" class="w-4 h-4 mr-1 md:mr-2" />
                <span class="hidden sm:inline">Skip</span>
                <span class="sm:hidden">Skip</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

