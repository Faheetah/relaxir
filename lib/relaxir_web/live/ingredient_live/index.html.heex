<div class="text-6xl text-center font-medium font-serif">
  All Ingredients

  <%= if @current_user && @current_user.is_admin do %>
    <.link href={~p"/ingredients/new"}>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 inline text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </.link>
  <% end %>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 py-8">
<%= for ingredient <- @ingredients do %>
  <div id={"ingredient-#{ingredient.id}"} class="group">
    <div class="relative overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow">
      <div class="mx-6 lg:mx-0">
        <.link href={~p"/ingredients/#{ingredient.id}/#{ingredient.name}"}>
          <%= if Map.get(ingredient, :image_filename) do %>
            <img src={"/uploads/#{ingredient.image_filename}-full.jpg"} class="w-full h-48 object-cover">
          <% else %>
            <img src="/images/default-full.jpg" class="w-full h-48 object-cover">
          <% end %>
        </.link>
      </div>
    </div>

    <div class="mx-6 lg:mx-0 mt-3">
      <div class="text-2xl tracking-tight leading-6 font-bold font-serif pb-2">
        <.link href={~p"/ingredients/#{ingredient.id}"} class="hover:text-amber-600 transition-colors">
          <%= String.capitalize(ingredient.name) %>
        </.link>
      </div>

      <%!-- Recipes using this ingredient --%>
      <% recipes = Map.get(@ingredient_recipes, ingredient.id, []) %>
      <%= if recipes != [] do %>
        <div class="mb-3">
          <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Used in</div>
          <div class="space-y-1">
            <%= for recipe <- recipes do %>
              <.link
                href={~p"/recipes/#{recipe.id}/#{recipe.title |> String.downcase |> String.replace(" ", "-")}"}
                class="block text-sm text-neutral-700 hover:text-amber-600 hover:underline decoration-amber-600 underline-offset-2 transition-colors"
              >
                <%= recipe.title %>
              </.link>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
</div>
