<div class="flex flex-col md:flex-row justify-between items-start gap-4">
  <div class="text-6xl font-medium font-serif">
    Inventory
  </div>

  <div class="flex flex-col items-end gap-3 w-full md:w-1/3">
    <%!-- Search bar with embedded add button (like recipes form) --%>
    <div class="w-full">
      <.form
        for={@form}
        id="inventory-search-form"
        phx-change="validate"
        phx-debounce="300"
      >
        <div class="relative">
          <.live_select
            id="ingredient-search-select"
            field={@form[:ingredient_search]}
            mode={:single}
            allow_clear={true}
            dropdown_extra_class="mt-4"
            option_extra_class="py-2"
            container_extra_class="flex flex-col"
            text_input_extra_class="w-full h-10 border-neutral-300 focus:ring-2 focus:ring-amber-500 focus:border-amber-500 rounded-lg px-4 pr-28"
            placeholder="Search ingredients..."
            style={:tailwind}
          />
          <div class="absolute right-0 top-0 bottom-0 flex items-center">
            <button
              type="button"
              class="h-full bg-amber-500 hover:bg-amber-600 text-white font-medium px-5 text-sm transition-colors rounded-r-lg"
              phx-click="add_ingredient"
              phx-disable-with="Adding..."
              disabled={!@search_results || length(@search_results) == 0}
            >
              <.icon name="hero-plus" class="h-4 w-4 mr-1 inline-block" />
              Add
            </button>
          </div>
        </div>
      </.form>
    </div>

    <%!-- Manage Inventories button --%>
    <button
      type="button"
      phx-click="open_labels_modal"
      class="w-full px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-medium rounded-lg flex items-center justify-center"
    >
      Manage Inventories
    </button>
  </div>
</div>

<%!-- Filters --%>
<div class="mt-6 mb-4 space-y-4">
  <%!-- Inventory type radio filters --%>
  <div class="flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium text-gray-600 mr-1">Inventory:</span>
    <button
      type="button"
      phx-click="filter_inventory"
      phx-value-inventory_id=""
      class={[
        "px-3 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer",
        if(is_nil(@filter_inventory_id),
          do: "bg-amber-500 border-amber-500 text-white",
          else: "bg-white border-gray-300 text-gray-700 hover:border-amber-400"
        )
      ]}
    >
      All
    </button>

    <button
      type="button"
      phx-click="filter_inventory"
      phx-value-inventory_id="unlabeled"
      class={[
        "px-3 py-1.5 rounded-full text-sm font-medium border transition-colors cursor-pointer",
        if(@filter_inventory_id == "unlabeled",
          do: "bg-amber-500 border-amber-500 text-white",
          else: "bg-white border-gray-300 text-gray-700 hover:border-amber-400"
        )
      ]}
    >
      Unlabeled
    </button>

    <%= for inventory <- @user_inventories do %>
      <button
        type="button"
        phx-click="filter_inventory"
        phx-value-inventory_id={inventory.id}
        class={[
          "px-3 py-1.5 rounded-full text-sm font-medium border transition-colors flex items-center gap-1.5 cursor-pointer",
          if(@filter_inventory_id == "#{inventory.id}",
            do: "bg-amber-500 border-amber-500 text-white",
            else: "bg-white border-gray-300 text-gray-700 hover:border-amber-400"
          )
        ]}
      >
        <.inventory_icon type={inventory.icon || "shelf"} class="w-4 h-4" />
        <%= inventory.name %>
      </button>
    <% end %>
  </div>

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
    <%!-- Shopping list toggle --%>
    <button
      type="button"
      phx-click="filter_restock"
      class={[
        "px-4 py-2 rounded-lg text-sm font-medium border transition-colors flex items-center gap-2",
        if(@filter_restock_only,
          do: "bg-amber-500 border-amber-500 text-white",
          else: "bg-white border-gray-300 text-gray-700 hover:border-amber-400"
        )
      ]}
    >
      <.icon name="hero-shopping-cart" class="h-4 w-4" />
      <%= if @filter_restock_only, do: "Shopping List", else: "Show Shopping List" %>
    </button>

    <%!-- Text search --%>
    <div class="relative flex-1 w-full sm:max-w-xs">
      <.icon name="hero-magnifying-glass" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
      <input
        type="text"
        name="filter_search"
        value={@filter_search}
        placeholder="Search items..."
        phx-keyup="filter_search"
        phx-debounce="300"
        class="w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
      />
    </div>
  </div>
</div>

<div>
  <%!-- Add Modal --%>
  <%= if @show_add_modal do %>
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
      <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Add Item</h3>
          <button
            type="button"
            phx-click="close_add_modal"
            class="text-gray-400 hover:text-gray-600"
          >
            <.icon name="hero-x-mark" class="h-5 w-5" />
          </button>
        </div>

        <.live_component
          module={RelaxirWeb.InventoryLive.FormComponent}
          id="add-item-form"
          action={:new}
          patch={~p"/inventory"}
        />
      </div>
    </div>
  <% end %>

  <%!-- Inventories Modal --%>
  <%= if @show_labels_modal do %>
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 flex items-center justify-center z-50">
      <div class="bg-white rounded-lg p-6 max-w-md w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-lg font-semibold">Manage Inventories</h3>
          <button
            type="button"
            phx-click="close_labels_modal"
            class="text-gray-400 hover:text-gray-600"
          >
            <.icon name="hero-x-mark" class="h-5 w-5" />
          </button>
        </div>

        <%!-- List existing inventories --%>
        <div class="mb-4">
          <h4 class="font-medium text-gray-700 mb-2">Existing Inventories</h4>
          <%= if length(@user_inventories) == 0 do %>
            <p class="text-gray-500 text-sm">No inventories yet. Create one below.</p>
          <% else %>
            <div class="space-y-2">
              <%= for inventory <- @user_inventories do %>
                <div class="flex justify-between items-center p-2 bg-gray-50 rounded">
                  <div class="flex items-center gap-2">
                    <.inventory_icon type={inventory.icon || "shelf"} class="w-6 h-6 text-gray-600" />
                    <span class="font-medium"><%= inventory.name %></span>
                  </div>
                  <button
                    type="button"
                    phx-click="delete_inventory_label"
                    phx-value-id={inventory.id}
                    class="text-red-500 hover:text-red-700 text-sm"
                  >
                    <.icon name="hero-x-mark" class="h-4 w-4" />
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%!-- Create new inventory form --%>
        <div>
          <h4 class="font-medium text-gray-700 mb-2">Create New Inventory</h4>
          <.simple_form
            for={%{}}
            id="create-label-form"
            phx-submit="create_inventory_label"
            class="mb-0"
          >
            <div class="space-y-3">
              <input
                type="text"
                name="inventory[name]"
                placeholder="Name (e.g., Pantry, Refrigerator)"
                class="w-full border-gray-300 rounded"
                required
              />
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Icon</label>
                <div class="flex gap-2 border-b-2 border-blue-500 pb-2">
                  <%= for icon <- ["refrigerator_french", "refrigerator_top", "freezer_chest", "shelf", "table"] do %>
                    <label class="cursor-pointer">
                      <input
                        type="radio"
                        name="inventory[icon]"
                        value={icon}
                        class="sr-only peer"
                      />
                      <div class="p-2 border-2 border-gray-200 rounded-lg hover:border-amber-400 peer-checked:border-amber-500 peer-checked:border-2 transition-colors">
                        <.inventory_icon type={icon} class="w-8 h-8 text-gray-600" />
                      </div>
                    </label>
                  <% end %>
                </div>
              </div>
              <button
                type="submit"
                class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded"
              >
                Create
              </button>
            </div>
          </.simple_form>
        </div>
      </div>
    </div>
  <% end %>
</div>


<%!-- Grouped Items --%>
<%= if map_size(@grouped_items) == 0 do %>
  <div class="text-center p-8 border border-dashed border-gray-300 rounded-lg">
    <p class="text-gray-500 mb-4">Your inventory is empty.</p>
    <p class="text-gray-400 text-sm">Search for ingredients above to add them to your inventory.</p>
  </div>
<% else %>
  <%= for {category, items} <- @grouped_items do %>
    <div class="mb-8">
      <div class="text-2xl font-bold mb-4 pb-2 border-b border-gray-300">
        <%= String.capitalize(category) %>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-1">
        <%= for item <- items do %>
          <.live_component
            module={RelaxirWeb.InventoryLive.InventoryTileComponent}
            id={item.id}
            item={item}
            user_inventories={@user_inventories}
            show_inventory_overlay={false}
          />
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<%!-- Form Modal --%>
<.modal :if={@live_action in [:new, :edit]} id="item-modal" show on_cancel={JS.patch(~p"/inventory")}>
  <.live_component
    module={RelaxirWeb.InventoryLive.FormComponent}
    id={@item.id || :new}
    title={@page_title}
    action={@live_action}
    item={@item}
    patch={~p"/inventory"}
  />
</.modal>
